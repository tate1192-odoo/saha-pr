# Satır sonu, girinti ve sonlandırma kuralları — editör ve araçlar buradan okur.
[*.{css,js,json,less,md,py,rst,sass,scss,xml,yaml,yml}]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,rst,md}]
indent_size = 2

# Vendored kütüphaneler ve üretilmiş içerik: biçim kuralı uygulanmaz
[{*/static/{lib,src/lib}/**,*/static/description/index.html}]
