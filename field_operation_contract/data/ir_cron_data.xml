<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_cron_field_operation_contract_recurring" model="ir.cron" forcecreate="1">
            <field name="name">Field Contract: Generate Recurring Operations</field>
            <field name="model_id" ref="model_field_operation_contract"/>
            <field name="state">code</field>
            <field name="code">model.action_recurring_process()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=6)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
