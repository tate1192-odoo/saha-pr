<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_field_operation_contract_partner_form" model="ir.ui.view">
        <field name="name">res.partner.field.operation.contract</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" name="show_service_contract" type="object" icon="fa-tasks"
                        invisible="service_contract_count == 0">
                    <field name="service_contract_count" widget="statinfo" string="Contract"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
