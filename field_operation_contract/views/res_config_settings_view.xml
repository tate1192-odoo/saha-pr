<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_contract" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.field.operation.contract</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="field_operation.res_config_settings_view_form_field_operation"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='service_planning_container']" position="inside">
                <setting id="contract_generation_lead"
                         string="Contract generation lead"
                         help="Periodic contract sale orders and field operations are created this many days before the service date, so the office can plan staff and routes. Set it per customer; 7 days is the default.">
                    <field name="contract_generation_lead_days"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
