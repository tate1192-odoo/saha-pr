<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_filter_field_operation" model="ir.ui.view">
        <field name="name">res.partner.filter.field.operation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
                <separator/>
                <filter string="Services"
                        name="has_field_operation"
                        domain="[('field_operation_count', '>', 0)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_field_operation_partner_form" model="ir.ui.view">
        <field name="name">res.partner.field.operation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button"
                        name="action_view_field_operation"
                        type="object" icon="fa-tasks"
                        help="Shows services for this partner and related contacts"
                >
                    <field name="field_operation_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>

    <record id="field_operation_partner_action" model="ir.actions.act_window">
        <field name="name">Customers with Services</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('field_operation_count', '>', 0)]</field>
        <field name="context">
            {'search_default_has_field_operation': 1,
            'default_is_company': True,
            'default_customer_rank': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                These customers have field services
            </p>
        </field>
    </record>

</odoo>
