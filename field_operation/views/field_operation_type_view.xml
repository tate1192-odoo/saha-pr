<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service Type -->
    <record id="field_operation_type_search_view" model="ir.ui.view">
        <field name="name">Operation Type</field>
        <field name="model">field.operation.type</field>
        <field name="arch" type="xml">
            <search string="Service Type">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="field_operation_type_form_view" model="ir.ui.view">
        <field name="name">Operation Type</field>
        <field name="model">field.operation.type</field>
        <field name="arch" type="xml">
            <form string="Service Type">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="field_operation_type_list_view" model="ir.ui.view">
        <field name="name">Operation Type</field>
        <field name="model">field.operation.type</field>
        <field name="arch" type="xml">
            <list string="Service Type" editable="top" sample="1">
                <field name="priority" widget="priority" nolabel="1"/>
                <field name="name"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <record id="action_field_operation_type" model="ir.actions.act_window">
        <field name="name">Operation Type</field>
        <field name="res_model">field.operation.type</field>
        <field name="view_id" ref="field_operation_type_list_view"/>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                Use Operation Type to categorize your service.
            </p>
        </field>
    </record>

</odoo>
