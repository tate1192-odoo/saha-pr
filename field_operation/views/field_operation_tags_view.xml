<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service Tags -->
    <record id="view_field_operation_tags_form" model="ir.ui.view">
        <field name="name">field_operation.tags.form</field>
        <field name="model">field.operation.tags</field>
        <field name="arch" type="xml">
            <form string="Tags">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_field_operation_tags_list" model="ir.ui.view">
        <field name="name">field_operation.tags.list</field>
        <field name="model">field.operation.tags</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_field_operation_tags_search" model="ir.ui.view">
        <field name="name">field_operation.tags.search</field>
        <field name="model">field.operation.tags</field>
        <field name="arch" type="xml">
            <search string="Tags">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_field_operation_tags" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">field.operation.tags</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tag
            </p>
        </field>
    </record>
</odoo>
