<odoo>
    <!-- A field worker reads every job they are assigned to, closed ones
         included: the mobile history and the desktop list both need them. Draft
         jobs stay hidden until the planning is final. -->
    <record id="rule_service_worker" model="ir.rule">
        <field name="name">Field: Assigned Jobs (read)</field>
        <field name="model_id" ref="field_operation.model_field_operation"/>
        <field name="domain_force">[
            ('person_ids.user_id','=',user.id),
            ('status','in',['planned','progress','done','cancel'])
        ]</field>
        <field name="groups" eval="[(4, ref('service_group_worker'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Writing is limited to the open part of the flow: once a job is done or
         cancelled it is history and only the office may still edit it. -->
    <record id="rule_service_worker_write" model="ir.rule">
        <field name="name">Field: Assigned Jobs (write)</field>
        <field name="model_id" ref="field_operation.model_field_operation"/>
        <field name="domain_force">[
            ('person_ids.user_id','=',user.id),
            ('status','in',['planned','progress'])
        ]</field>
        <field name="groups" eval="[(4, ref('service_group_worker'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="service_user_rule" model="ir.rule">
        <field name="name">Office: Own Documents</field>
        <field ref="model_field_operation" name="model_id"/>
        <field name="domain_force">['|',('user_id','=',user.id),('user_id','=',False)]</field>
        <field name="groups" eval="[(4, ref('service_group_user'))]"/>
    </record>

    <record id="service_all_rule" model="ir.rule">
        <field name="name">Head Office: All Documents</field>
        <field ref="model_field_operation" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('service_group_all'))]"/>
    </record>

    <record id="rule_service_portal" model="ir.rule">
        <field name="name">Portal: Customer Jobs</field>
        <field name="model_id" ref="field_operation.model_field_operation"/>
        <field name="domain_force">['|',
            ('partner_id', 'child_of', user.partner_id.commercial_partner_id.id),
            ('message_partner_ids', 'child_of', user.partner_id.commercial_partner_id.id)
            ]
        </field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record model="ir.rule" id="multi-company_service_rule">
        <field name="name">Service multi-company</field>
        <field name="model_id" search="[('model','=','field.operation')]" model="ir.model"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
