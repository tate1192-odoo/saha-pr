<odoo>
    <!-- BASIC HIERARCHY -->
    <!-- 1. Field worker - Lowest level -->
    <record id="service_group_worker" model="res.groups">
        <field name="name">Field Worker</field>
        <field name="privilege_id" ref="field_operation.field_operation_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 3. Office Staff - Planning and coordination -->
    <record id="service_group_user" model="res.groups">
        <field name="name">Office User</field>
        <field name="privilege_id" ref="field_operation.field_operation_privilege"/>
        <field name="implied_ids" eval="[(4, ref('service_group_worker'))]"/>
    </record>

    <!-- 5. Head Office -->
    <record id="service_group_all" model="res.groups">
        <field name="name">Head Office</field>
        <field name="privilege_id" ref="field_operation.field_operation_privilege"/>
        <field name="implied_ids" eval="[(4, ref('service_group_user'))]"/>
    </record>

    <!-- 6. Admin -->
    <record id="service_group_manager" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="field_operation.field_operation_privilege"/>
        <field name="implied_ids" eval="[(4, ref('service_group_all'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Hidden Privilege for Technical Groups -->
    <record id="field_operation_hidden_privilege" model="res.groups.privilege">
        <field name="name">Field Operation Technical</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="sequence">100</field>
    </record>

    <record id="group_field_operation_recurring" model="res.groups">
        <field name="name">Recurring Service Planning</field>
        <field name="privilege_id" ref="field_operation.field_operation_hidden_privilege"/>
    </record>
    <record id="group_field_operation_signature" model="res.groups">
        <field name="name">Digital Signature Usage</field>
        <field name="privilege_id" ref="field_operation.field_operation_hidden_privilege"/>
    </record>

</odoo>
