<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_field_operation_stock_line_list" model="ir.ui.view">
        <field name="name">field.operation.stock.line.list</field>
        <field name="model">field.operation.stock.line</field>
        <field name="arch" type="xml">
            <list string="Stock Consumption"
                  decoration-success="state == 'done'"
                  decoration-warning="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" readonly="1"/>
                <field name="product_id"/>
                <field name="product_code"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="subtotal"/>
                <field name="consumption_type" widget="badge"
                       decoration-info="consumption_type == 'serviced'"
                       decoration-success="consumption_type == 'warranty'"/>
                <field name="stock_picking_id" readonly="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_field_operation_stock_line_form" model="ir.ui.view">
        <field name="name">field.operation.stock.line.form</field>
        <field name="model">field.operation.stock.line</field>
        <field name="arch" type="xml">
            <form string="Stock Consumption Line">
                <header>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="operation_id" invisible="not context.get('default_operation_id')"/>
                            <field name="product_id"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                            <field name="quantity"/>
                            <field name="consumption_type"/>
                        </group>
                        <group>
                            <field name="unit_price"/>
                            <field name="subtotal"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="stock_picking_id" readonly="1"/>
                            <field name="stock_move_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Add notes..."/>
                    </group>
                    <group>
                        <field name="company_id" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_field_operation_stock_line_search" model="ir.ui.view">
        <field name="name">field.operation.stock.line.search</field>
        <field name="model">field.operation.stock.line</field>
        <field name="arch" type="xml">
            <search string="Search Stock Consumption">
                <field name="name"/>
                <field name="product_id"/>
                <field name="operation_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Servise Dahil" name="serviced" domain="[('consumption_type', '=', 'serviced')]"/>
                <filter string="Garanti / Ücretsiz" name="warranty" domain="[('consumption_type', '=', 'warranty')]"/>
                <separator/>
                <filter string="Consumption Type" name="group_type" context="{'group_by': 'consumption_type'}"/>
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                <filter string="Operation" name="group_operation" context="{'group_by': 'operation_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_field_operation_stock_line" model="ir.actions.act_window">
        <field name="name">Stock Consumption</field>
        <field name="res_model">field.operation.stock.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_field_operation_stock_line_search"/>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stock consumption records found.
            </p>
        </field>
    </record>

</odoo>
