<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Machine Maintenance - List View -->
    <record id="machine_maintenance_list_view" model="ir.ui.view">
        <field name="name">machine.maintenance.list</field>
        <field name="model">machine.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance Records" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="machine_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="maintenance_type" widget="badge"/>
                <field name="priority" widget="priority"/>
                <field name="technician_id"/>
                <field name="total_cost"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state in ('draft', 'scheduled')"
                       decoration-info="state == 'in_progress'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="next_maintenance_date" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Machine Maintenance - Form View -->
    <record id="machine_maintenance_form_view" model="ir.ui.view">
        <field name="name">machine.maintenance.form</field>
        <field name="model">machine.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Record">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Start" type="object" class="btn-primary"
                            invisible="state != 'scheduled'"/>
                    <button name="action_done" string="Complete" type="object" class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-danger"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Machine">
                            <field name="machine_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Details">
                            <field name="maintenance_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="technician_id"/>
                        </group>
                        <group string="Dates">
                            <field name="date"/>
                            <field name="next_maintenance_date"/>
                            <field name="days_until_next" invisible="not next_maintenance_date"/>
                            <field name="duration_hours"/>
                        </group>
                        <group string="Costs">
                            <field name="labor_cost"/>
                            <field name="parts_cost"/>
                            <field name="total_cost"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" widget="html"/>
                                <field name="work_performed" widget="html"/>
                                <field name="result" widget="badge"
                                       decoration-success="result == 'success'"
                                       decoration-warning="result == 'partial'"
                                       decoration-danger="result == 'failed'"/>
                            </group>
                        </page>
                        <!-- Costs are computed from the linked stock spare parts
                             (machine.spare.part), so the parts list is read-only here. -->
                        <page string="Spare Parts Used">
                            <field name="spare_part_ids" readonly="True">
                                <list>
                                    <field name="date"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="subtotal" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="parts_cost" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Related">
                            <group>
                                <field name="operation_id"/>
                            </group>
                        </page>
                        <page string="Images">
                            <group>
                                <field name="image_before" widget="image"/>
                                <field name="image_after" widget="image"/>
                            </group>
                        </page>
                        <page string="Internal Notes">
                            <field name="internal_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Machine Maintenance - Search View -->
    <record id="machine_maintenance_search_view" model="ir.ui.view">
        <field name="name">machine.maintenance.search</field>
        <field name="model">machine.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance Records">
                <field name="name"/>
                <field name="machine_id"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <filter string="My Maintenance" name="my_maintenance" domain="[('technician_user_id', '=', uid)]"/>
                <filter string="Scheduled" name="scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'done')]"/>
                <filter string="Due This Week" name="due_week"
                        domain="[('next_maintenance_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('next_maintenance_date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Machine" name="machine" context="{'group_by': 'machine_id'}"/>
                <filter string="Type" name="type" context="{'group_by': 'maintenance_type'}"/>
                <filter string="State" name="state" context="{'group_by': 'state'}"/>
                <filter string="Technician" name="technician" context="{'group_by': 'technician_id'}"/>
                <filter string="Date" name="date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <!-- Machine Maintenance - Action -->
    <record id="machine_maintenance_action" model="ir.actions.act_window">
        <field name="name">Maintenance Records</field>
        <field name="res_model">machine.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_scheduled': 1, 'search_default_in_progress': 1}</field>
    </record>

    <!-- Machine Maintenance - Menu -->
    <menuitem id="machine_maintenance_menu"
              name="Maintenance"
              parent="machine_master_menu_root"
              action="machine_maintenance_action"
              sequence="20"/>

    <!-- Maintenance Schedule Views -->
    <record id="maintenance_schedule_list_view" model="ir.ui.view">
        <field name="name">machine.maintenance.schedule.list</field>
        <field name="model">machine.maintenance.schedule</field>
        <field name="arch" type="xml">
            <list string="Maintenance Schedules">
                <field name="name"/>
                <field name="machine_id"/>
                <field name="maintenance_type"/>
                <field name="interval_number"/>
                <field name="interval_type"/>
                <field name="last_date"/>
                <field name="next_date"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="maintenance_schedule_form_view" model="ir.ui.view">
        <field name="name">machine.maintenance.schedule.form</field>
        <field name="model">machine.maintenance.schedule</field>
        <field name="arch" type="xml">
            <form string="Maintenance Schedule">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Schedule Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Machine">
                            <field name="machine_id"/>
                        </group>
                        <group string="Interval">
                            <div>
                                <label for="interval_number" string="Every"/>
                                <field name="interval_number" class="oe_inline"/>
                                <field name="interval_type" class="oe_inline"/>
                            </div>
                        </group>
                        <group string="Schedule">
                            <field name="maintenance_type"/>
                            <field name="last_date" readonly="True"/>
                            <field name="next_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="maintenance_schedule_action" model="ir.actions.act_window">
        <field name="name">Maintenance Schedules</field>
        <field name="res_model">machine.maintenance.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="maintenance_schedule_menu"
              name="Maintenance Schedules"
              parent="field_operation.menu_field_operation_config"
              action="maintenance_schedule_action"
              sequence="10"/>
</odoo>
