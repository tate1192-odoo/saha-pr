<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company record rules.

         Every model below carries a company_id, so without a rule a user
         working in company A would read the machines, documents, maintenance
         records, schedules and spare part usages belonging to company B. The
         rules are declared as global rules (global=True) so they apply to every
         user regardless of their service group and cannot be relaxed by another
         group's rule. `company_ids` is the list of companies the current user
         is allowed to access. -->
    <record id="machine_master_company_rule" model="ir.rule">
        <field name="name">Machine Master: multi-company</field>
        <field name="model_id" ref="model_machine_master"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="machine_document_company_rule" model="ir.rule">
        <field name="name">Machine Document: multi-company</field>
        <field name="model_id" ref="model_machine_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="machine_maintenance_company_rule" model="ir.rule">
        <field name="name">Machine Maintenance: multi-company</field>
        <field name="model_id" ref="model_machine_maintenance"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="machine_maintenance_schedule_company_rule" model="ir.rule">
        <field name="name">Machine Maintenance Schedule: multi-company</field>
        <field name="model_id" ref="model_machine_maintenance_schedule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="machine_spare_part_company_rule" model="ir.rule">
        <field name="name">Machine Spare Part: multi-company</field>
        <field name="model_id" ref="model_machine_spare_part"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
