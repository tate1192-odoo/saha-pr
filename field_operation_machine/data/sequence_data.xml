<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequences -->
    <record id="seq_machine_maintenance" model="ir.sequence">
        <field name="name">Machine Maintenance</field>
        <field name="code">machine.maintenance</field>
        <field name="prefix">MNT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_machine_spare_part" model="ir.sequence">
        <field name="name">Machine Spare Part</field>
        <field name="code">machine.spare.part</field>
        <field name="prefix">SPR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Cron Jobs -->
    <record id="cron_notify_expiring_warranties" model="ir.cron">
        <field name="name">Machine: Notify Expiring Warranties</field>
        <field name="model_id" ref="model_machine_master"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_expiring_warranties()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_notify_expiring_insurance" model="ir.cron">
        <field name="name">Machine: Notify Expiring Insurance</field>
        <field name="model_id" ref="model_machine_master"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_expiring_insurance()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_notify_upcoming_maintenance" model="ir.cron">
        <field name="name">Machine: Notify Upcoming Maintenance</field>
        <field name="model_id" ref="model_machine_maintenance"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_upcoming_maintenance()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_generate_maintenance_from_schedule" model="ir.cron">
        <field name="name">Machine: Generate Scheduled Maintenance</field>
        <field name="model_id" ref="model_machine_maintenance_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_maintenance()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
