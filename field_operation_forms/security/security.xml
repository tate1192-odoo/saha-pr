<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="field_operation_forms_module_category" model="ir.module.category">
        <field name="name">Field Service Forms</field>
        <field name="sequence">23</field>
    </record>

    <record id="privilege_forms_user" model="res.groups.privilege">
        <field name="name">Field User</field>
        <field name="category_id" ref="field_operation_forms_module_category"/>
    </record>

    <record id="forms_user" model="res.groups">
        <field name="name">Field User</field>
        <field name="privilege_id" ref="privilege_forms_user"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="privilege_forms_all" model="res.groups.privilege">
        <field name="name">All Data</field>
        <field name="category_id" ref="field_operation_forms_module_category"/>
    </record>

    <record id="forms_all" model="res.groups">
        <field name="name">All Data</field>
        <field name="privilege_id" ref="privilege_forms_all"/>
        <field name="implied_ids" eval="[(4, ref('forms_user'))]"/>
    </record>

    <record id="privilege_forms_manager" model="res.groups.privilege">
        <field name="name">Field Manager</field>
        <field name="category_id" ref="field_operation_forms_module_category"/>
    </record>

    <record id="forms_manager" model="res.groups">
        <field name="name">Field Manager</field>
        <field name="privilege_id" ref="privilege_forms_manager"/>
        <field name="implied_ids" eval="[(4, ref('forms_all'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Rules -->
    <!-- The field user sees a form when he leads the team OR is one of its assigned
         people, and only while it is still open: a form leaves his list as soon as it is
         closed (Done/Cancel), which is the behaviour the field asked for. -->
    <record id="forms_user_rule" model="ir.rule">
        <field name="name">Field User</field>
        <field name="model_id" ref="model_field_operation_forms"/>
        <field name="domain_force">['&amp;', ('status', 'in', ('new', 'completed')),
            '|', ('team_leader_id', '=', user.id), ('person_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('forms_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="forms_all_rule" model="ir.rule">
        <field name="name">All Data</field>
        <field name="model_id" ref="model_field_operation_forms"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('forms_all'))]"/>
    </record>

    <record id="forms_manager_rule" model="ir.rule">
        <field name="name">Manager</field>
        <field name="model_id" ref="model_field_operation_forms"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('forms_manager'))]"/>
    </record>

    <record id="field_operation_forms_portal_rule" model="ir.rule">
        <field name="name">Form Service Portal</field>
        <field name="model_id" ref="model_field_operation_forms"/>
        <field name="domain_force">['|',
            ('message_partner_ids', 'child_of', [user.partner_id.commercial_partner_id.id]),
            ('customer_id', 'in', [user.partner_id.id])
            ]
        </field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="multi-company_form_rule" model="ir.rule">
        <field name="name">Service multi-company</field>
        <field name="model_id" ref="model_field_operation_forms"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
