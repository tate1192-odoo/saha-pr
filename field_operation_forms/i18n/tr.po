#: model:mail.template,body_html:field_operation_forms.field_operation_forms_email_template
msgid ""
"<div style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 14px; color: #333333;\">\n"
"                <p>Sayın <t t-out=\"object.customer_id.name or ''\"/>,</p>\n"
"\n"
"                <p>\n"
"                    <strong t-out=\"object.name\"/> numaralı saha servis formunuz ekte yer almaktadır.\n"
"                </p>\n"
"\n"
"                <table cellspacing=\"0\" cellpadding=\"4\" style=\"border-collapse: collapse;\">\n"
"                    <tr>\n"
"                        <td style=\"color: #666666;\">Konu</td>\n"
"                        <td t-out=\"object.subject or ''\"/>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666666;\">Servis Tipi</td>\n"
"                        <td t-out=\"object.service_type_id.name or ''\"/>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666666;\">Servis Adresi</td>\n"
"                        <td t-out=\"object.address_id.display_name or ''\"/>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666666;\">Başlangıç</td>\n"
"                        <td>\n"
"                            <span t-field=\"object.start_date\" t-options=\"{'format': 'dd/MM/yyyy HH:mm'}\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666666;\">Bitiş</td>\n"
"                        <td>\n"
"                            <span t-field=\"object.end_date\" t-options=\"{'format': 'dd/MM/yyyy HH:mm'}\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <p>\n"
"                    Formun ayrıntılarını ve imzalarını portal üzerinden görüntüleyebilirsiniz:\n"
"                    <a t-att-href=\"object.get_portal_url()\" t-out=\"object.get_portal_url()\"/>\n"
"                </p>\n"
"\n"
"                <p>Saygılarımla</p>\n"
"                <p>\n"
"                    <t t-out=\"object.company_id.name or ''\">Company</t>\n"
"                </p>\n"
"            </div>\n"
"        "
