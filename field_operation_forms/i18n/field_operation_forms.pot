"                    <tr>\n"
"                        <td style=\"color: #666666;\">Servis Adresi</td>\n"
"                        <td t-out=\"object.address_id.display_name or ''\"/>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666666;\">Başlangıç</td>\n"
"                        <td>\n"
"                            <span t-field=\"object.start_date\" t-options=\"{'format': 'dd/MM/yyyy HH:mm'}\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666666;\">Bitiş</td>\n"
"                        <td>\n"
"                            <span t-field=\"object.end_date\" t-options=\"{'format': 'dd/MM/yyyy HH:mm'}\"/>\n"
