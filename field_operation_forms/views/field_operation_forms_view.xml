<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- search view definition -->
    <record id="field_operation_forms_search_view" model="ir.ui.view">
        <field name="name">field.operation.forms.search</field>
        <field name="model">field.operation.forms</field>
        <field name="arch" type="xml">
            <search string="Service Form">
                <field name="name" string="No" filter_domain="[('name', 'ilike', self)]"/>
                <field name="customer_id" filter_domain="[('customer_id', 'child_of', self)]"/>
                <field name="team_id"/>
                <field name="service_type"/>
                <field name="status"/>
                <filter string="My Tasks" name="my_tasks" domain="[('team_leader_id', '=', uid)]"/>
                <filter string="My Task" name="my_task" domain="[('person_ids.user_id', '=', uid)]"/>
                <separator/>
                <filter string="New" name="new" domain="[('status', '=', 'new')]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <filter string="Team" name="group_team_id" context="{'group_by': 'team_id'}"/>
                <filter string="Assigned Person" name="group_by_person" context="{'group_by': 'person_ids'}"/>
            </search>
        </field>
    </record>

    <!-- list view definition -->
    <record id="field_operation_forms_list_view" model="ir.ui.view">
        <field name="name">field.operation.forms.list</field>
        <field name="model">field.operation.forms</field>
        <field name="arch" type="xml">
            <list string="Service Form" decoration-success="status == 'done'" decoration-warning="status == 'new'">
                <field name="name" optional="hide"/>
                <field name="service_type" optional="show"/>
                <field name="subject" optional="hide"/>
                <field name="customer_id" optional="hide"/>
                <field name="contact_id" optional="show"/>
                <field name="contact_mobile" optional="show"/>
                <field name="area_id" optional="hide"/>
                <field name="address_id" optional="hide"/>
                <field name="team_id" optional="show"/>
                <field name="team_leader_id" optional="hide"/>
                <field name="person_ids" optional="show" widget='many2many_tags_avatar'/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status" optional="show"/>
                <field name="company_id" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- form view -->
    <record id="field_operation_forms_form_view" model="ir.ui.view">
        <field name="name">field.operation.forms.form</field>
        <field name="model">field.operation.forms</field>
        <field name="arch" type="xml">
            <form>
                <field name="company_id" invisible="1"/>
                <header>
                    <button name="action_completed" type="object" string="Completed" class="oe_highlight"
                            invisible="status in ('completed','done','cancel')"/>
                    <button name="action_signe_form" string="Signature" type="object" class="btn btn-warning"
                            invisible="signed and status in ('new','done','cancel') "/>
                    <button name="action_done" type="object" string="Done" class="oe_highlight"
                            invisible="status in ('new','done','cancel')" groups="field_operation_forms.forms_manager"/>
                    <button name="action_mail_send" type="object" string="Email" class="btn-danger"
                            invisible="status in ('new','completed','cancel')"
                            groups="field_operation_forms.forms_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" class="oe_highlight"
                            invisible="status not in ('completed','done')"
                            groups="field_operation_forms.forms_manager"/>
                    <button name="action_draft" type="object" string="Draft" class="oe_highlight"
                            invisible="status not in ('cancel')"/>
                    <field name="status" widget="statusbar" statusbar_visible="new,completed,done,cancel"
                           readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="show_operation" type="object" icon="fa-tasks"
                                invisible="operation_count == 0" groups="field_operation_forms.forms_manager">
                            <field name="operation_count" widget="statinfo" string="Operation"/>
                        </button>
                    </div>
                    <div class="oe_title pe-0">
                        <h2 class="d-flex justify-content-between align-items-center">
                            <div class="d-flex w-100">
                                <div class="d-flex w-100">
                                    <field name="subject" options="{'line_breaks': False}" widget="text"
                                           class="o_task_name text-truncate w-md-75 w-100 pe-2"
                                           placeholder="Service Title..."/>
                                </div>
                                <div class="d-flex justify-content-start o_state_container w-100 w-md-50 w-lg-25">
                                    <field name="name" readonly="1"/>
                                </div>
                            </div>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" options="{'no_create_edit': True, 'no_create': True,}"
                                   readonly="status != 'done'" groups="field_operation_forms.forms_user"/>
                            <field name="contact_id" create="0"
                                   context="{'default_type':'contact', 'show_address': False, 'show_vat': False, 'contact_display': 'name_only'}"/>
                            <field name="contact_mobile"/>
                            <field name="address_id"
                                   context="{'default_type':'delivery', 'show_address': True, 'show_vat': False}"/>
                            <field name="team_id" options="{'no_create_edit': True, 'no_create': True,}"/>
                            <field name="team_leader_id" options="{'no_create_edit': True, 'no_create': True,}"/>
                            <field name="person_ids" widget="many2many_tags"
                                   options="{'no_create_edit': True, 'no_create': True,}"/>
                        </group>
                        <group>
                            <field name="service_type_id" required="1"
                                   options="{'no_create_edit': True, 'no_create': True,}"/>
                            <field name="service_type" invisible="1"/>
                            <field name="start_date"/>
                            <field name="end_date" required="1"/>
                            <field name="signed" readonly="1"/>
                            <field name="user_id" options="{'no_create_edit': True}" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="notes">
                            <field name="description" placeholder="Add description notes."/>
                        </page>

                        <page string="Signature" name="signature" readonly="1">
                            <group>
                                <field name="signed_on"/>
                                <field name="customer_signed_by"/>
                                <field name="staff_signed_by"/>
                                <field name="customer_signature" widget="signature"/>
                                <field name="staff_signature" widget="signature"/>
                            </group>
                        </page>
                        <page string="Solution" name="solution">
                            <field name="solution" placeholder="Add solution notes."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="field_operation_forms_view_pivot" model="ir.ui.view">
        <field name="name">field.operation.forms.pivot</field>
        <field name="model">field.operation.forms</field>
        <field name="arch" type="xml">
            <pivot string="Service Forms" sample="1">
                <field name="team_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- action -->
    <record id="action_field_operation_forms" model="ir.actions.act_window">
        <field name="name">Service Forms</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">field.operation.forms</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="field_operation_forms_search_view"/>
        <field name="context">{'search_default_new': 1, 'search_default_my_tasks': 1}</field>
        <field name="domain">[]</field>
        <field name="view_id" eval="False"/>
    </record>


</odoo>
