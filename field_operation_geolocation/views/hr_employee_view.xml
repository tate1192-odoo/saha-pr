<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_employee_form_home_location" model="ir.ui.view">
        <field name="name">hr.employee.form.home.location</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='hr_location_group']" position="inside">
                <field name="home_location_id"/>
            </xpath>
        </field>
    </record>
</odoo>
