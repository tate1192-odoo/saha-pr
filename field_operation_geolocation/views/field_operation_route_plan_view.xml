<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_field_operation_route_plan_form" model="ir.ui.view">
        <field name="name">field.operation.route.plan.form</field>
        <field name="model">field.operation.route.plan</field>
        <field name="arch" type="xml">
            <form string="Route Plan">
                <header>
                    <button
                            name="action_save_order"
                            type="object"
                            string="Save Order"
                            class="btn-primary"
                    />
                    <button
                            name="action_suggest_order"
                            type="object"
                            string="Suggest Order"
                    />
                    <button
                            name="action_geolocate_stops"
                            type="object"
                            string="Geolocate Stops"
                            groups="base.group_user"
                    />
                    <button name="action_open_map" type="object" string="Open Map"/>
                    <button name="action_reload" type="object" string="Reload Stops"/>
                </header>
                <group>
                    <group>
                        <field name="team_id" options="{'no_create': True}"/>
                        <field name="date"/>
                        <field name="shift_times"/>
                    </group>
                    <group>
                        <field name="total_km"/>
                        <field name="suggested_km"/>
                        <field name="missing_count" invisible="1"/>
                        <field name="is_consistent" invisible="1"/>
                    </group>
                </group>
                <field name="info" readonly="1"/>
                <field name="line_ids">
                    <list editable="bottom" default_order="sequence">
                        <field name="sequence" widget="handle"/>
                        <field name="start_time"/>
                        <field name="operation_id"/>
                        <field name="district"/>
                        <field name="leg_km"/>
                        <field name="partner_id" optional="hide"/>
                        <field name="is_located" optional="hide"/>
                    </list>
                </field>
            </form>
        </field>
    </record>
</odoo>
