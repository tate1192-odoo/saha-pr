<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        One privilege for the module, in the category the suite shares: its two
        levels (User / Manager) are its dropdown, the way core's "Employees" or
        "Fleet" rows work. Each level used to be a privilege of its own in a
        category of the module's own, so the user form carried a second box for
        the same product.
    -->
    <record id="privilege_route" model="res.groups.privilege">
        <field name="name">Route</field>
        <field name="category_id" ref="field_operation.module_category_saha_operation"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_user_field_operation_route" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_route"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_manager_field_operation_route" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_route"/>
        <field name="implied_ids" eval="[(4, ref('group_user_field_operation_route'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!--
        A data record cannot delete what it no longer declares: the two
        per-level privileges and the module's own category are removed here.
    -->
    <function model="res.groups.privilege" name="_field_operation_geolocation_drop_legacy_privileges"/>

    <data noupdate="0">
        <record id="field_operation_route_user_rule" model="ir.rule">
            <field name="name">Field Operation Route Personal Data</field>
            <field name="model_id" ref="field_operation.model_field_operation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('field_operation_geolocation.group_user_field_operation_route'))]"/>
        </record>

        <record id="field_operation_route_manager_rule" model="ir.rule">
            <field name="name">Field Operation Route Manager</field>
            <field name="model_id" ref="field_operation.model_field_operation"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('field_operation_geolocation.group_manager_field_operation_route'))]"/>
        </record>

        <!-- Office users plan their team's day. The base rule in
             field_operation only shows their own and unassigned jobs
             ("Office: Own Documents"), so a dispatcher who did not create every
             service got an empty route plan. Group rules are OR'ed per user:
             this widens what an office user sees to the jobs of the teams they
             lead, head or belong to - and to nothing else. -->
        <record id="field_operation_office_team_rule" model="ir.rule">
            <field name="name">Office: My Team's Documents</field>
            <field name="model_id" ref="field_operation.model_field_operation"/>
            <field name="domain_force">['|', '|',
                ('team_id.team_leader_id', '=', user.id),
                ('team_id.team_head_id.user_id', '=', user.id),
                ('team_id.team_members_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('field_operation.service_group_user'))]"/>
        </record>

        <!-- GPS history is personal data: a user may only see the history of the
             teams they belong to (member, leader or head). Managers are granted
             full visibility below; group rules are OR'ed per user, so a manager
             who is also in the user group still sees everything. -->
        <record id="team_location_history_user_rule" model="ir.rule">
            <field name="name">Team Location History: Own Team Only</field>
            <field name="model_id" ref="model_team_location_history"/>
            <field name="domain_force">['|', '|',
                ('team_id.team_members_ids.user_id', '=', user.id),
                ('team_id.team_head_id.user_id', '=', user.id),
                ('team_id.team_leader_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('field_operation.service_group_user')), (4, ref('field_operation_geolocation.group_user_field_operation_route'))]"/>
        </record>

        <record id="team_location_history_manager_rule" model="ir.rule">
            <field name="name">Team Location History: Manager</field>
            <field name="model_id" ref="model_team_location_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('field_operation.service_group_manager')), (4, ref('field_operation_geolocation.group_manager_field_operation_route'))]"/>
        </record>
    </data>

</odoo>
