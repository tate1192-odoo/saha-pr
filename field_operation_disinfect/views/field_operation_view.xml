<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_field_operation_disinfect_form" model="ir.ui.view">
        <field name="name">field.operation.disinfect.form</field>
        <field name="model">field.operation</field>
        <field name="inherit_id" ref="field_operation.view_field_operation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group name="disinfect_ph" invisible="service_type_id.type != 'disinfect'">
                    <group string="Before Cleaning">
                        <field name="before_ph"/>
                        <field name="before_cl"/>
                    </group>
                    <group string="After Cleaning">
                        <field name="after_ph"/>
                        <field name="after_cl"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//notebook/page[@name='solution']" position="after">
                <page string="Disinfect" name="disinfect"
                      invisible="service_type_id.type != 'disinfect'">
                    <field name="disinfect_ids"
                           widget="section_and_note_one2many"
                           context="{'default_operation_id': id}">
                        <list editable="bottom">
                            <field name="product_id"
                                   options="{'no_create_edit': True, 'no_create': True}"/>
                            <field name="tank_dimensions"/>
                            <field name="disinfection" widget="boolean_toggle"/>
                            <field name="cleaning" widget="boolean_toggle"/>
                            <field name="ozone" widget="boolean_toggle"/>
                            <field name="filter_change" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
