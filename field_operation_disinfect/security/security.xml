<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">
        <!-- Field user: only disinfection lines belonging to their teams -->
        <record id="disinfect_user_rule" model="ir.rule">
            <field name="name">Disinfect: Personal Data</field>
            <field name="model_id" ref="model_field_operation_disinfect"/>
            <field name="domain_force">['|',
                ('forms_id.team_leader_id', '=', user.id),
                ('forms_id.person_ids.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('field_operation_forms.forms_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: all data -->
        <record id="disinfect_manager_rule" model="ir.rule">
            <field name="name">Disinfect: Manager</field>
            <field name="model_id" ref="model_field_operation_disinfect"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('field_operation_forms.forms_manager'))]"/>
        </record>

        <!-- Multi-company isolation -->
        <record id="disinfect_company_rule" model="ir.rule">
            <field name="name">Disinfect: Multi-Company</field>
            <field name="model_id" ref="model_field_operation_disinfect"/>
            <field name="domain_force">[('forms_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>

</odoo>
