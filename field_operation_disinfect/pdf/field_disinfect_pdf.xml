<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <template id="pdf_field_disinfect">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="field_operation_forms.external_forms">
                    <t t-call="field_operation_disinfect.field_disinfect_layout" t-lang="doc.customer_id.lang"/>
                </t>
            </t>
        </t>
    </template>
    <template id="field_disinfect_layout">
        <div class="page">
            <div class="oe_structure"/>
            <div class="row">
                <div t-att-class="'col-9' if report_type == 'pdf' else 'col-md-8 col-12'">
                    <h2>Disinfection Service Form</h2>
                </div>

                <div t-att-class="'col-3' if report_type == 'pdf' else 'col-md-4 col-12'">
                    <span>Form No:</span>
                    <span t-field="doc.name"/>
                    <br/>
                    <span>Date:</span>
                    <span t-field="doc.start_date" t-options="{'widget': 'datetime', 'format': 'dd/MM/YYYY - hh:mm'}">
                        2023-01-01
                    </span>
                </div>
            </div>
            <br/>
            <br/>
            <div class="row">
                <div t-att-class="'col-6' if report_type == 'pdf' else 'col-md-6 col-12'">
                    <div class="mb-3" t-if="doc.customer_id">
                        <div>
                            <strong>Customer:</strong>
                        </div>
                        <div t-out="doc.customer_id.name">Marc Demo</div>

                    </div>
                </div>
                <div t-attf-class="{{ 'col-6' if report_type == 'pdf' else 'col-md-6 col-12' }} mb-3"
                     t-if="doc.customer_id">
                    <div>
                        <strong>Address:</strong>
                    </div>
                    <div t-out="doc.customer_id" t-options='{
						"widget": "contact",
						"fields": ["address", "phone", "email"]}'
                    >
                    </div>
                </div>
            </div>

            <div t-if="doc.disinfect_ids" name="worksheet_task_timesheet">
                <!--                <h2>Water Tank Cleaning</h2>-->
                <div t-att-class="'table-responsive-sm' if report_type != 'pdf' else ''">
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th class="text-start">Tank/Dispenser</th>
                                <th class="text-start">Dimensions</th>
                                <th class="text-start">Disinfection</th>
                                <th class="text-start">Cleaning</th>
                                <th class="text-start">Ozone</th>
                                <th class="text-start">Filter Change</th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody">
                            <t t-foreach="doc.disinfect_ids" t-as="line">
                                <tr t-att-style="'background-color: #F1F1F1;' if line_index % 2 == 0 else ''">
                                    <td>
                                        <span t-field="line.product_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.tank_dimensions"/>
                                    </td>
                                    <td class="text-start">
                                        <t t-if="line.disinfection == true">
                                            <i class="fa fa-check-square-o" aria-hidden="true"/>
                                        </t>
                                        <t t-if="line.disinfection == false">
                                            <i class="fa fa-square-o" aria-hidden="true"/>
                                        </t>
                                    </td>
                                    <td class="text-start">
                                        <t t-if="line.cleaning == true">
                                            <i class="fa fa-check-square-o" aria-hidden="true"/>
                                        </t>
                                        <t t-if="line.cleaning == false">
                                            <i class="fa fa-square-o" aria-hidden="true"/>
                                        </t>
                                    </td>
                                    <td class="text-start">
                                        <t t-if="line.ozone == true">
                                            <i class="fa fa-check-square-o" aria-hidden="true"/>
                                        </t>
                                        <t t-if="line.ozone == false">
                                            <i class="fa fa-square-o" aria-hidden="true"/>
                                        </t>
                                    </td>
                                    <td class="text-start">
                                        <t t-if="line.filter_change == true">
                                            <i class="fa fa-check-square-o" aria-hidden="true"/>
                                        </t>
                                        <t t-if="line.filter_change == false">
                                            <i class="fa fa-square-o" aria-hidden="true"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

            <br/>
            <br/>
            <br/>

            <div t-if="doc.solution" class="col-12">
                <strong>Solution:</strong>
                <br/>
                <span t-field="doc.solution"/>
            </div>
            <br/>
            <br/>
            <div class="row">
                <div class="col-6">
                    <div t-attf-class="{{ 'col-12 col-lg-4' if report_type != 'html' else 'col-sm-7 col-md-5' }} ms-auto "
                         style="page-break-inside: avoid;">
                        <h5>Signature</h5>
                        <img t-if="doc.staff_signature" t-att-src="image_data_uri(doc.staff_signature)"
                             style="max-height: 6rem; max-width: 100%; color:black;"/>
                        <br/>
                        <span t-field="doc.staff_signed_by">Marc Demo</span>
                    </div>
                </div>

                <div class="col-6">
                    <div t-attf-class="{{ 'col-12 col-lg-4' if report_type != 'html' else 'col-sm-7 col-md-5' }} ms-auto "
                         style="page-break-inside: avoid;">
                        <h5>Signature</h5>
                        <img t-if="doc.customer_signature" t-att-src="image_data_uri(doc.customer_signature)"
                             style="max-height: 6rem; max-width: 100%; color:black;"/>
                        <br/>
                        <span t-field="doc.customer_signed_by">Marc Demo</span>
                    </div>
                </div>

            </div>
        </div>
    </template>

    <record id="action_field_disinfect_pdf" model="ir.actions.report">
        <field name="name">Disinfect</field>
        <field name="model">field.operation.forms</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">field_operation_disinfect.pdf_field_disinfect</field>
        <field name="report_file">field_operation_disinfect.pdf_field_disinfect</field>
        <!--  <field name="paperformat_id" ref="uzman_pdf.paper_project_task"/> -->
        <field name="binding_model_id" ref="field_operation_forms.model_field_operation_forms"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
