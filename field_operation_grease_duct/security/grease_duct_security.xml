<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Field worker: only grease duct lines of their own operations -->
        <record id="grease_duct_line_user_rule" model="ir.rule">
            <field name="name">Grease Duct: Personal Data</field>
            <field name="model_id" ref="model_field_operation_grease_duct"/>
            <field name="domain_force">['|',
                ('operation_id.team_leader_id', '=', user.id),
                ('operation_id.person_ids.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('field_operation.service_group_worker'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Office users and above: all data -->
        <record id="grease_duct_line_user_all_rule" model="ir.rule">
            <field name="name">Grease Duct: Office</field>
            <field name="model_id" ref="model_field_operation_grease_duct"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('field_operation.service_group_user'))]"/>
        </record>

        <!-- Manager: all data -->
        <record id="grease_duct_line_manager_rule" model="ir.rule">
            <field name="name">Grease Duct: Manager</field>
            <field name="model_id" ref="model_field_operation_grease_duct"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('field_operation.service_group_manager'))]"/>
        </record>

        <!-- Multi-company isolation -->
        <record id="grease_duct_line_company_rule" model="ir.rule">
            <field name="name">Grease Duct: Multi-Company</field>
            <field name="model_id" ref="model_field_operation_grease_duct"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
