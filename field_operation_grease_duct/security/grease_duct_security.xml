<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Field user: only grease duct lines of the forms they are assigned to -->
        <record id="grease_duct_line_user_rule" model="ir.rule">
            <field name="name">Grease Duct: Personal Data</field>
            <field name="model_id" ref="model_field_operation_grease_duct_line"/>
            <field name="domain_force">['|',
                ('forms_id.team_leader_id', '=', user.id),
                ('forms_id.person_ids.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('field_operation_forms.forms_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <!-- The domain must cover create and unlink too: a disabled flag means
                 "no rule for that operation", i.e. every readable form would accept
                 a new line and a mistyped one could never be removed. -->
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Manager: all data -->
        <record id="grease_duct_line_manager_rule" model="ir.rule">
            <field name="name">Grease Duct: Manager</field>
            <field name="model_id" ref="model_field_operation_grease_duct_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('field_operation_forms.forms_manager'))]"/>
        </record>

        <!-- Multi-company isolation -->
        <record id="grease_duct_line_company_rule" model="ir.rule">
            <field name="name">Grease Duct: Multi-Company</field>
            <field name="model_id" ref="model_field_operation_grease_duct_line"/>
            <field name="domain_force">[('forms_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
