<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Adds the pest-control details to the operation service report.
         The optional field_operation_forms_pest bridge keeps the form-side
         flow; customers without forms use this report directly. -->
    <template id="field_pest_operation_section"
              inherit_id="field_operation.field_work_delivery_pdf">
        <xpath expr="//div[@t-if='o.tag_ids']" position="after">
            <t t-if="o.service_type_id.type == 'pest'">
                <div t-if="o.pest_type_ids or o.hygiene or o.infestation or o.insulation or o.storage or o.efk_ift or o.monitors or o.others"
                     style="margin-bottom:15px;">
                    <strong>Pest Control Details</strong>
                    <table class="table table-sm" style="width:100%; margin-top:5px;">
                        <tbody>
                            <tr t-if="o.pest_type_ids">
                                <td><strong>Pest Type</strong></td>
                                <td>
                                    <t t-foreach="o.pest_type_ids" t-as="pest_type">
                                        <span t-field="pest_type.name"/>
                                        <t t-if="not pest_type_last">, </t>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Application</strong></td>
                                <td>
                                    <span t-if="o.hygiene">Hygiene </span>
                                    <span t-if="o.infestation">Infestation </span>
                                    <span t-if="o.insulation">Insulation </span>
                                    <span t-if="o.storage">Storage </span>
                                    <span t-if="o.efk_ift">EFK-IFT </span>
                                    <span t-if="o.monitors">Monitors </span>
                                    <span t-if="o.others">Others</span>
                                </td>
                            </tr>
                            <tr t-if="o.application_place">
                                <td><strong>Application Place</strong></td>
                                <td><span t-field="o.application_place"/></td>
                            </tr>
                            <tr t-if="o.residence">
                                <td><strong>Residential Flats</strong></td>
                                <td><span t-field="o.residence"/></td>
                            </tr>
                            <tr t-if="o.place">
                                <td><strong>Area</strong></td>
                                <td><span t-field="o.place"/></td>
                            </tr>
                            <tr t-if="o.application_method">
                                <td><strong>Application Method</strong></td>
                                <td><span t-field="o.application_method"/></td>
                            </tr>
                            <tr t-if="o.responsible_manager_id">
                                <td><strong>Responsible Manager</strong></td>
                                <td><span t-field="o.responsible_manager_id.name"/></td>
                            </tr>
                            <tr t-if="o.company_id.biocidal_certificate">
                                <td><strong>Certificate</strong></td>
                                <td><span t-field="o.company_id.biocidal_certificate"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div t-if="o.security_precautions" style="margin-bottom:15px;">
                    <strong>Security Precautions</strong>
                    <div t-field="o.security_precautions" style="margin-top:5px;"/>
                </div>

                <div t-if="o.pesticide_ids" style="margin-bottom:15px;">
                    <strong>Pesticide Products</strong>
                    <table class="table table-sm o_main_table" style="width:100%; margin-top:5px;">
                        <thead>
                            <tr>
                                <th class="text-start">Product</th>
                                <th class="text-start">Active Ingredient</th>
                                <th class="text-start">Package</th>
                                <th class="text-start">Unit</th>
                                <th class="text-end">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.pesticide_ids" t-as="line">
                                <tr t-att-style="'background-color: #F1F1F1;' if line_index % 2 == 0 else ''">
                                    <td><span t-field="line.product_id"/></td>
                                    <td><span t-field="line.product_id.active_ingredient"/></td>
                                    <td><span t-field="line.product_id.package"/></td>
                                    <td><span t-field="line.product_uom"/></td>
                                    <td class="text-end"><span t-field="line.product_qty"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
