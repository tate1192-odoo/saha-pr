<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pest Type -->
    <record id="field_operation_pest_type_search_view" model="ir.ui.view">
        <field name="name">Pest Type</field>
        <field name="model">field.operation.pest.type</field>
        <field name="arch" type="xml">
            <search string="Pest Type">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="field_operation_pest_type_form_view" model="ir.ui.view">
        <field name="name">Pest Type</field>
        <field name="model">field.operation.pest.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <!-- <field name="color" widget="color_picker"/> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="field_operation_pest_type_list_view" model="ir.ui.view">
        <field name="name">field.operation.pest.type.list</field>
        <field name="model">field.operation.pest.type</field>
        <field name="arch" type="xml">
            <list string="Pest Type">
                <field name="name"/>
                <field name="sequence" widget="handle"/>
            </list>
        </field>
    </record>

    <record id="action_field_operation_pest_type" model="ir.actions.act_window">
        <field name="name">Pest Type</field>
        <field name="res_model">field.operation.pest.type</field>
<!--        <field name="view_id" ref="field_operation_pest_type_list_view"/>-->
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            name="Pest Type"
            id="menu_field_operation_pest_type"
            action="action_field_operation_pest_type"
            sequence="5"
            parent="field_operation.menu_field_operation_config"
    />

</odoo>
