<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW  -->
    <record id="field_operation_pest_form_view" model="ir.ui.view">
        <field name="name">field.operation.form</field>
        <field name="model">field.operation</field>
        <field name="inherit_id" ref="field_operation.view_field_operation_form"/>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="pest_type_ids" widget="many2many_tags"
                       invisible="service_type_id.type != 'pest'"
                       options="{'color_field': 'color', 'no_create_edit': True, 'no_create': True,}"/>
            </field>
        </field>
    </record>

</odoo>
