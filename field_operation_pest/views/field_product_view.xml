<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- search view definition -->
    <record id="field_product_search_view" model="ir.ui.view">
        <field name="name">field.product.search</field>
        <field name="model">field.product</field>
        <field name="arch" type="xml">
            <search string="Field Product">
                <field name="name"/>
                <field name="type"/>
            </search>
        </field>
    </record>

    <!-- list view definition -->
    <record id="field_product_tree_view" model="ir.ui.view">
        <field name="name">field.product.list</field>
        <field name="model">field.product</field>
        <field name="arch" type="xml">
            <list string="Field Product">
                <field name="priority" widget="priority" nolabel="1"/>
                <field name="name"/>
                <field name="type"/>
                <field name="sequence"/>
            </list>
        </field>
    </record>

    <!-- form view definition -->
    <record id="field_product_form_view" model="ir.ui.view">
        <field name="name">field.product.form</field>
        <field name="model">field.product</field>
        <field name="arch" type="xml">
            <form string="Field Product">
                <header>

                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="field_product_view_pivot" model="ir.ui.view">
        <field name="name">field.product.pivot</field>
        <field name="model">field.product</field>
        <field name="arch" type="xml">
            <pivot string="Field Product" sample="1">
                <field name="name" type="row"/>
                <field name="name" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- action -->
    <record id="action_field_product" model="ir.actions.act_window">
        <field name="name">Field Product</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">field.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_field_product_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="field_product_tree_view"/>
        <field name="act_window_id" ref="action_field_product"/>
    </record>

    <record id="action_field_product_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="field_product_form_view"/>
        <field name="act_window_id" ref="action_field_product"/>
    </record>

</odoo>
