<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_report_wizard_form" model="ir.ui.view">
        <field name="name">field.operation.attendance.wizard.form</field>
        <field name="model">field.operation.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Monthly Field Work Schedule">
                <sheet>
                    <group>
                        <group string="Period Selection">
                            <field name="month"/>
                            <field name="year"/>
                            <field name="count_date_range"/>
                        </group>
                        <group string="Display Options">
                            <field name="theme" widget="radio"/>
                        </group>
                    </group>
                    <group string="Employee Selection (Leave empty for all employees)">
                        <field name="employee_ids" nolabel="1" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"
                            icon="fa-print"/>
                    <button name="action_export_xlsx" string="Export Excel" type="object" class="btn-secondary"
                            icon="fa-file-excel-o"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">Monthly Field Work Schedule</field>
        <field name="res_model">field.operation.attendance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="field_operation.model_field_operation"/>
        <!-- Restrict the model cog-menu action to the same group that holds the wizard ACL
             (security/ir.model.access.csv -> field_operation.service_group_user). Without this,
             any user able to read field.operation (e.g. Field Worker) sees the action but hits
             an AccessError when the wizard model is opened. -->
        <field name="group_ids" eval="[(4, ref('field_operation.service_group_user'))]"/>
    </record>

    <menuitem id="menu_attendance_report_wizard"
              name="Monthly Work Schedule"
              parent="field_operation.menu_field_operation_reports"
              action="action_attendance_report_wizard"
              sequence="100"/>
</odoo>
