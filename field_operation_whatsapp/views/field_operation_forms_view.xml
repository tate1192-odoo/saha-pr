<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_field_operation_forms_whatsapp_form" model="ir.ui.view">
        <field name="name">field.operation.forms.whatsapp.form</field>
        <field name="model">field.operation.forms</field>
        <field name="inherit_id" ref="field_operation_forms.field_operation_forms_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                        name="action_message_send"
                        string="Whatsapp"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-whatsapp"
                        groups="field_operation.service_group_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
