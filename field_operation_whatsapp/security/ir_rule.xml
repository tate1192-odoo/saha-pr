<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company record rule.

         `field.whatsapp.log` stores the phone number of the customer and the
         text that was sent, so without a rule a user working in company A would
         read the messages of company B. The rule is global (global=True) so it
         applies to every user regardless of their service group and cannot be
         relaxed by another group's rule. `company_ids` is the list of companies
         the current user is allowed to access. -->
    <record id="field_whatsapp_log_company_rule" model="ir.rule">
        <field name="name">Field WhatsApp Log: multi-company</field>
        <field name="model_id" ref="model_field_whatsapp_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
