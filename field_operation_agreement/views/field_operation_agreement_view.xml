<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Agreement Tree View                                          -->
    <!-- ============================================================ -->
    <record id="view_agreement_tree" model="ir.ui.view">
        <field name="name">field.operation.agreement.tree</field>
        <field name="model">field.operation.agreement</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'expired'"
                  decoration-muted="status == 'cancelled'"
                  decoration-info="status == 'draft'">
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="agreement_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status == 'draft'"
                       decoration-danger="status in ('expired', 'cancelled')"/>
                <field name="total_amount" sum="Total" widget="monetary"/>
                <field name="operation_count"/>
                <field name="company_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Agreement Search View                                        -->
    <!-- ============================================================ -->
    <record id="view_agreement_search" model="ir.ui.view">
        <field name="name">field.operation.agreement.search</field>
        <field name="model">field.operation.agreement</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="description"/>
                <separator/>
                <filter name="draft" string="Draft"
                        domain="[('status', '=', 'draft')]"/>
                <filter name="active" string="Active"
                        domain="[('status', '=', 'active')]"/>
                <filter name="expired" string="Expired"
                        domain="[('status', '=', 'expired')]"/>
                <filter name="cancelled" string="Cancelled"
                        domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter name="maintenance" string="Maintenance"
                        domain="[('agreement_type', '=', 'maintenance')]"/>
                <filter name="service" string="Service"
                        domain="[('agreement_type', '=', 'service')]"/>
                <filter name="pest_control" string="Pest Control"
                        domain="[('agreement_type', '=', 'pest_control')]"/>
                <separator/>
                <filter name="my_agreements" string="My Agreements"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <group>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'agreement_type'}"/>
                    <filter name="group_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Agreement Form View                                          -->
    <!-- ============================================================ -->
    <record id="view_agreement_form" model="ir.ui.view">
        <field name="name">field.operation.agreement.form</field>
        <field name="model">field.operation.agreement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            groups="field_operation.service_group_user"
                            invisible="status not in ('draft', 'expired')"/>
                    <button name="action_expire" type="object"
                            string="Expire"
                            groups="field_operation.service_group_user"
                            invisible="status != 'active'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            groups="field_operation.service_group_user"
                            invisible="status in ('cancelled', 'expired')"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft"
                            groups="field_operation.service_group_user"
                            invisible="status == 'draft'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_operations" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                invisible="not operation_count">
                            <field name="operation_count" widget="statinfo"
                                   string="Operations"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                        <label for="name" class="oe_edit_only"/>
                        <h2>
                            <field name="name" placeholder="Agreement Name..."/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_create': True}"/>
                            <field name="contact_id"
                                   options="{'no_create': True}"/>
                            <field name="agreement_type"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="total_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms &amp; Conditions">
                            <group>
                                <group>
                                    <field name="template_id"
                                           domain="[('agreement_type', '=', agreement_type)]"
                                           options="{'no_create': False}"/>
                                </group>
                                <group>
                                    <button name="action_load_template"
                                            type="object"
                                            string="Load Template"
                                            class="btn-primary"
                                            icon="fa-arrow-down"
                                            groups="field_operation.service_group_user"
                                            invisible="not template_id"
                                            help="Load the selected template into the agreement content below"/>
                                </group>
                            </group>
                            <field name="description"
                                   options="{'placeholder': 'Enter agreement terms and conditions...'}"/>
                        </page>
                        <page string="Operations"
                              invisible="not field_operation_ids">
                            <field name="field_operation_ids"
                                   context="{'default_agreement_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="status"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="service_price"
                                           widget="monetary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Signature" name="signature">
                            <group>
                                <group>
                                    <field name="signed"/>
                                    <field name="signed_on"
                                           invisible="not signed"/>
                                    <field name="signed_by"
                                           invisible="not signed"/>
                                </group>
                                <group>
                                    <field name="signature"
                                           widget="signature"
                                           invisible="signed"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Agreement Action                                              -->
    <!-- ============================================================ -->
    <record id="action_agreement" model="ir.actions.act_window">
        <field name="name">Agreements</field>
        <field name="res_model">field.operation.agreement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_agreement_search"/>
    </record>

</odoo>
