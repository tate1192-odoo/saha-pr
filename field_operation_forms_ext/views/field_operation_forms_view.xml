<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_field_operation_forms_map_list" model="ir.ui.view">
        <field name="name">field.operation.forms.route.list</field>
        <field name="model">field.operation.forms</field>
        <field name="inherit_id" ref="field_operation_forms.field_operation_forms_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <button
                        name="action_open_map"
                        type="object"
                        string="Open Maps"
                        class="btn-primary"
                />
            </xpath>
        </field>
    </record>

    <record id="field_operation_forms_map_message_form_view" model="ir.ui.view">
        <field name="name">field_operation_forms.route.form</field>
        <field name="model">field.operation.forms</field>
        <field name="inherit_id" ref="field_operation_forms.field_operation_forms_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                        class="oe_stat_button"
                        name="action_open_map"
                        type="object"
                        string="Map"
                        icon="fa-map-marker"
                />
                <button
                        class="oe_stat_button"
                        name="action_geolocate_address"
                        type="object"
                        string="Geolocate"
                        icon="fa-location-arrow"
                        groups="base.group_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
