<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="field_operation_view_mode_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div class="oe_button_box" name="button_box" position="inside">
                <button class="oe_stat_button" name="show_field_operation" type="object" icon="fa-tasks"
                        invisible="field_operation_count == 0">
                    <field name="field_operation_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
