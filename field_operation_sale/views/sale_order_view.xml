<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="field_operation_sale_order_form_view" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <header>
                <button name="create_sale_service"
                        string="Service"
                        type="object"
                        class="oe_highlight"
                        groups="field_operation_sale.group_field_operation_sale_enabled"
                        invisible="order_types != 'service' or field_operation_count"
                />
            </header>
            <div class="oe_button_box" name="button_box" position="inside">
                <button class="oe_stat_button" name="show_field_operation" type="object" icon="fa-tasks"
                        invisible="field_operation_count == 0">
                    <field name="field_operation_count" widget="statinfo"/>
                </button>
            </div>
            <field name="partner_id" position="after">
                <field name="order_types"/>
            </field>
        </field>
    </record>
</odoo>
