<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.field.operation.sale</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <app name="field_operation" position="inside">
                <block title="Field Operation Sale" name="field_operation_sale_container">
                    <setting id="field_operation_sale_enabled"
                             help="Enable sales creation from field operations."
                             title="Create Sale Feature">
                        <field name="group_field_operation_sale_enabled"/>
                    </setting>
                    <setting id="field_operation_sale_default_product"
                             help="Set default product for sales."
                             title="Default Sale Product"
                             groups="field_operation_sale.group_field_operation_sale_enabled">
                        <field name="field_operation_sale_default_product_id"/>
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
