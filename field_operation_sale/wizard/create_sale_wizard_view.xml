<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_field_operation_create_sale_wizard" model="ir.ui.view">
        <field name="name">field.operation.create.sale.wizard.form</field>
        <field name="model">field.operation.create.sale.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Sale from Field Operation">
                <group>
                    <group>
                        <field name="product_id"/>
                    </group>
                    <group>
                        <field name="operation_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_sale"
                            string="Create Sale"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_field_operation_create_sale_wizard" model="ir.actions.act_window">
        <field name="name">Create Sale</field>
        <field name="res_model">field.operation.create.sale.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="field_operation.model_field_operation"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('field_operation_sale.group_field_operation_sale_enabled'))]"/>
    </record>
</odoo>
